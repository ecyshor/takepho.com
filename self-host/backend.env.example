# Copy this file to backend.env (next to compose.yaml) and uncomment/adjust settings as needed.
# DATA_DIR, TAKEOUT_SOURCE_DIR, and DRIVE_DOWNLOAD_DIR are fixed by the image
# and should NOT be changed here.

# Parallel ingestion workers
# INGEST_WORKERS=4

# Trip detection: photo gap in hours that splits trip segments
# TRIP_TIME_GAP_HOURS=36

# Home detection radius in kilometers
# HOME_RADIUS_KM=50

# Day trip: max distance from home (km) to still be a day trip
# DAY_TRIP_MAX_KM=300

# AI curation: target number of curated photos per trip (2-10)
# CURATION_TARGET_COUNT=6

# Reverse geocoding user agent
# GEOCODING_USER_AGENT=takeout-photo

# Strava API application (strava.com/settings/api; see https://takepho.com/self-host/#google-sign-in-and-strava-at-naslocal8080).
# Optional: the values can also be pasted on the Strava card in Settings.
# STRAVA_CLIENT_ID=123456
# STRAVA_CLIENT_SECRET=your-client-secret

# Licensing (a plan is always required, in every runtime; see
# the self-hosting guide ("Plans and licensing")): sign in and buy a plan from
# Settings -> Account in the browser at http://<nas-host>:8080. The server
# needs internet at least once a month to refresh the signed entitlement.
